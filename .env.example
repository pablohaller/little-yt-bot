DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Fixes YouTube "403 Forbidden" on playback. Path to a cookies.txt exported
# from a logged-in YouTube account (Netscape format).
YTDLP_COOKIES=
# Set to 1 to force IPv4 (some IPv6 ranges get 403'd by YouTube).
YTDLP_FORCE_IPV4=
